{
  "name": "Java + Maven + Ollama Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "customizations": {
    "jetbrains": {
      "plugins": [
        "org.jetbrains.idea.maven",
        "com.github.copilot"
      ]
    }
  },

  "mounts": [
    "source=ollama-models,target=/root/.ollama,type=volume"
  ],

  "postCreateCommand": "ollama serve > /var/log/ollama.log 2>&1 &",

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Spring Boot App",
      "onAutoForward": "notify"
    }
  }
  
}